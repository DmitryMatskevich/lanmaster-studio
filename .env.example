DATABASE_URL=sqlite:////app/var/studio.db
STUDIO_STORAGE_DIR=/app/var/storage
STUDIO_ENV=dev
STUDIO_AUTH_MODE=dev
STUDIO_UPLOAD_MAX_SIZE_BYTES=52428800
STUDIO_UPLOAD_ALLOWED_MEDIA_TYPES=application/pdf,image/svg+xml,image/png,image/jpeg,text/plain,application/dxf,application/octet-stream,model/gltf-binary,model/step,model/ifc
STUDIO_UPLOAD_ALLOWED_SCOPES=source,model,view,release
